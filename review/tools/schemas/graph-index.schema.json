{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "required": [
        "files",
        "modules",
        "classes",
        "methods",
        "tests",
        "surfaces"
      ],
      "type": "object"
    },
    "layer": {
      "const": "index"
    },
    "paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "object"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "commit",
        "tree_sha256",
        "inputs"
      ],
      "type": "object"
    }
  },
  "required": [
    "layer",
    "provenance",
    "counts",
    "paths"
  ],
  "type": "object"
}
