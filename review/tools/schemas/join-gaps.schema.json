{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "gaps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "enum": [
              "derived-not-projected",
              "projected-not-derived"
            ],
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "direction",
          "layer",
          "finding"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "object"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "commit",
        "tree_sha256",
        "inputs"
      ],
      "type": "object"
    }
  },
  "required": [
    "provenance",
    "gaps"
  ],
  "title": "review/join/gaps.json",
  "type": "object"
}
