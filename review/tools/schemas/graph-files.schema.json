{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "end": {
                    "type": "integer"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "line",
                  "end",
                  "sha256"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "doc": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "section": {
                    "type": "string"
                  }
                },
                "required": [
                  "doc",
                  "section"
                ],
                "type": "object"
              }
            ]
          },
          "to": {
            "type": "string"
          },
          "verb": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "verb"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "type": "integer"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "lines": {
            "type": "integer"
          },
          "module": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "summary": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "path",
          "language",
          "sha256",
          "lines"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "layer": {
      "const": "files"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "object"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "commit",
        "tree_sha256",
        "inputs"
      ],
      "type": "object"
    }
  },
  "required": [
    "layer",
    "provenance",
    "files"
  ],
  "title": "review/graph/files.json",
  "type": "object"
}
