{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review/brief/sections/<nn>.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "anchor",
    "doc",
    "page",
    "markdown",
    "html",
    "nodes",
    "subsections",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "anchor": {
      "type": "string"
    },
    "doc": {
      "type": "string"
    },
    "page": {
      "type": "string"
    },
    "markdown": {
      "type": "string"
    },
    "html": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "layer"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          }
        }
      }
    },
    "subsections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "anchor",
          "markdown",
          "html",
          "nodes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "layer"
              ],
              "properties": {
                "id": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "layer": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "doc_sha256"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "doc_sha256": {
          "type": "string"
        }
      }
    }
  }
}
