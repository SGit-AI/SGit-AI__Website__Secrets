{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review/intent/claims.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims",
    "releases",
    "anchors",
    "edges",
    "provenance"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "feature",
          "area",
          "name",
          "status",
          "since",
          "where",
          "notes",
          "source"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
            "type": "string"
          },
          "feature": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "shipped",
              "proposed",
              "absent"
            ]
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "where": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "doc",
              "section"
            ],
            "properties": {
              "doc": {
                "type": "string"
              },
              "section": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "name",
          "date",
          "notes",
          "tag",
          "commit",
          "run",
          "verified"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "run": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "ref",
          "href",
          "opens",
          "anchor"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "file",
              "test",
              "section",
              "doc",
              "url",
              "commit",
              "tag",
              "run"
            ]
          },
          "name": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "opens": {
            "type": "string"
          },
          "anchor": {
            "type": "boolean"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "verb"
        ],
        "properties": {
          "from": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
            "type": "string"
          },
          "to": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
            "type": "string"
          },
          "verb": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
