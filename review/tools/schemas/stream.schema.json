{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "end": {
                    "type": "integer"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "line",
                  "end",
                  "sha256"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "doc": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "section": {
                    "type": "string"
                  }
                },
                "required": [
                  "doc",
                  "section"
                ],
                "type": "object"
              }
            ]
          },
          "to": {
            "type": "string"
          },
          "verb": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "verb"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "entry": {
      "type": "string"
    },
    "max_depth": {
      "type": "integer"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": [
              "string",
              "null"
            ]
          },
          "depth": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "loc": {
            "type": "integer"
          },
          "module": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "type": "integer"
              },
              "line": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "line",
              "end",
              "sha256"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "depth",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "object"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "commit",
        "tree_sha256",
        "inputs"
      ],
      "type": "object"
    },
    "totals": {
      "type": "object"
    }
  },
  "required": [
    "provenance",
    "entry",
    "max_depth",
    "nodes",
    "edges",
    "totals"
  ],
  "title": "review/streams/<entry>.json",
  "type": "object"
}
